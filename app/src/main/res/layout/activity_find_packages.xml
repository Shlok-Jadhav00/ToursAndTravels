<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="12dp"
    tools:context=".user.FindPackagesActivity">

    <!-- In-list Live Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search" />

        <EditText
            android:id="@+id/etxtSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:hint="Search places or cities..."
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/warm_text_primary"
            android:textColorHint="@color/warm_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Filter & Sort Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/warm_primary"
                android:text="All"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterSaved"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/warm_surface_alt"
                android:text="Saved ♥"
                android:textAllCaps="false"
                android:textColor="@color/warm_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSortLowHigh"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/warm_surface_alt"
                android:text="Price: Low → High"
                android:textAllCaps="false"
                android:textColor="@color/warm_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSortHighLow"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/warm_surface_alt"
                android:text="Price: High → Low"
                android:textAllCaps="false"
                android:textColor="@color/warm_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSortTopRated"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/warm_surface_alt"
                android:text="Top Rated ★"
                android:textAllCaps="false"
                android:textColor="@color/warm_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/txtEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:padding="24dp"
        android:text="No places match your filter.\nTry clearing your search or tapping 'All'."
        android:textColor="@color/warm_text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutAnimation="@anim/layout_animation_up_to_down" />

</LinearLayout>
