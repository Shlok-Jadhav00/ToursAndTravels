<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/warm_bg"
    tools:context=".user.AddBookingsActivity">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:gravity="center">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Booking"
                android:textStyle="normal"
                android:textSize="34dp"
                android:textFontWeight="600"
                android:textAlignment="center"/>

            <EditText
                android:id="@+id/etxtUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:layout_marginTop="50dp"
                android:textColor="@color/black"
                android:background="@drawable/shape"
                android:hint="Enter User Name" />

            <EditText
                android:id="@+id/etxtMobileno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:layout_marginTop="10dp"
                android:textColor="@color/black"
                android:background="@drawable/shape"
                android:inputType="number"
                android:hint="Enter Mobile no" />

            <EditText
                android:id="@+id/etxtAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:layout_marginTop="10dp"
                android:textColor="@color/black"
                android:background="@drawable/shape"
                android:hint="Enter Your Address" />




            <Button
                android:id="@+id/btnBooking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:padding="15dp"
                android:onClick="btnBookingClick"
                android:backgroundTint="@color/warm_primary"
                android:textColor="@color/white"
                android:text="Confirm Booking" />


        </LinearLayout>
    </ScrollView>


</LinearLayout>
